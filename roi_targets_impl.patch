@@ -0,0 +1,70 @@
+[stack]
+name = "dev_real"
+
+[rig]
+# REAL stack: PLCs/DenSis are already running and emitting telemetry.
+# The supervisor starts core+tooling first, discovers live devices from telemetry,
+# then starts a HiP pool sized to the discovered devices.
+device_source = "real"
+# How long to listen for telemetry before provisioning the HiP pool.
+discovery_ms = 2000
+# Optional: expected axes list (documentation only, not used for spawning in REAL).
+axes = []
+
+[net]
+bind_host = "127.0.0.1"
+cmd_base = 52001
+ui_telem_base = 51002
+dev_telem_in = "172.16.17.5:52020"  # example: device telemetry coming into the core
+status_in = "127.0.0.1:51200"
+raw_in = "127.0.0.1:50100"
+intent = "127.0.0.1:51001"
+
+[services.core]
+enabled = true
+module = "steuerung3d.apps.core_udp_service"
+mode = "single"
+args = [
+  "--intent-in", "{net.intent}",
+  "--dev-telem-in", "{net.dev_telem_in}",
+  "--dev-cmd-base", "{net.cmd_base}",
+  "--dev-cmd-count", "4",  # adjust to your rig / or use explicit --dev-cmd-target
+  "--ui-telem-base", "{net.ui_telem_base}",
+  "--ui-telem-count", "4",
+]
+
+# NOTE: in REAL mode we do NOT spawn DenSi sims.
+[services.densi]
+enabled = true
+module = "steuerung3d.apps.den_si"
+mode = "per_axis"
+config = "configs/services/densi.toml"
+args = []
+
+[services.hip]
+enabled = true
+module = "steuerung3d.apps.hi_p"
+mode = "single"
+count = 1  # count must be int; 'auto' removed to avoid confusion
+config = "configs/services/hip.toml"
+args = [
+  "--telem-in", "{net.bind_host}:{net.ui_telem_base}",
+  "--intent-out", "{net.intent}",
+]
+
+[services.inputd]
+enabled = true
+module = "steuerung3d.apps.inputd"
+mode = "single"
+config = "configs/inputd_gamepad.toml"
+
+[services.joy2intent]
+enabled = true
+module = "steuerung3d.apps.joy2intent"
+mode = "single"
+config = "configs/joy2intent_bindings_gamepad.toml"
+args = [
+  "--raw-in", "{net.raw_in}",
+  "--intent-out", "{net.intent}",
+  # winches will be assigned in the UI once HiPs are attached.
+]
