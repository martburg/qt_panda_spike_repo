 # Canonical joy2intent service configuration
 # Used by profiles and distributed deployments.
+#
+# Policy: this file is intentionally explicit. Avoid silent code defaults.
+# If you add new operational knobs, prefer adding them here and making the loader require them.
+
+[io]
+# Where raw joystick/controller samples arrive (UdpRawControlsIn bind address).
+raw_in = "127.0.0.1:50100"
+# Where intents are sent (UdpIntentOut target address).
+intent_out = "127.0.0.1:51001"
+tick_hz = 50
+stale_after_ms = 200
+
+[identity]
+# Must match the claim owner (HiP). Stamped into motion intents.
+hip_id = "hip"
+
+[rig]
+# Ordered axis ids (pos 0..N-1). Selection buttons address by position.
+winches = ["Anton", "Debby", "Cecil", "Burt"]
+# Physical button indices used to select winches by position (0..N-1).
+# Example: [0,1,2,3] means button0 selects winch[0], button1 selects winch[1], ...
+select_buttons = [0, 1, 2, 3]
 
 [mode]
 # Joystick control sub-mode (not the core safety Mode)
