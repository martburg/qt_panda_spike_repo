+                return
+
+            axis_id = str(axis_id or "")
+            hip_id = str(hip_id or "")
+            op = ParamEditBeginOp(group=grp)
+
+            if axis_id and hasattr(state, "pending_param_ops_by_axis"):
+                owner = state.claim_owner(axis_id)
+                if owner and hip_id and owner != hip_id:
+                    return
