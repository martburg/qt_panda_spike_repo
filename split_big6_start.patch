+            else:
+                state.pending_param_ops.append(op)
+            return
+
+        case ParamCancel(axis_id=axis_id, hip_id=hip_id, group=grp, req_id=req_id, session_id=session_id):
+            _txn_ack(state, req_id)
+            if _txn_seen_or_mark(state, req_id):
