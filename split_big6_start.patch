+                return
+            cmd = state.axis_cmd[axis_id]  # ensured by ensure_axis() above
+            if cmd.enable:
+                cmd.vel = float(rate)
+            return
+
+        case JogCartesian(vx=vx, vy=vy, vz=vz, hip_id=hip_id):
+            # v0.1: if the system has axes named X/Y/Z, map directly to JogAxis.
