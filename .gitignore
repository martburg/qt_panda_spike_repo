# =========================
# Python / tooling
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.dylib

.venv/
venv/
.env
.env.*

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# =========================
# Build / dist
# =========================
build/
dist/
*.whl
pip-wheel-metadata/

# =========================
# IDE / editor
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# OS junk
# =========================
Thumbs.db
.DS_Store

# =========================
# Runtime artefacts (Steuerung3D Remake)
# =========================
# per-session supervisor runs (portable LATEST file lives here too)
.run/
run/

# if you ever use a different run dir name
logs/
src/logs/

# =========================
# Logs / recordings (local-only by default)
# =========================
*.log
*.jsonl

# If there are JSONL fixtures you DO want in git, whitelist them like:
# !tests/**/fixtures/**/*.jsonl

# =========================
# Obsidian / knowledge vault (local-only)
# =========================
vault/
# If you keep attachments inside the repo but want them ignored:
# vault/Attachments/

# =========================
# Local helper tooling
# =========================
Logs/*.log
Logs/server.lock
